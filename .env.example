# Retryv Environment Configuration

# Gemini API Key (Required for embeddings, generation, and verification)
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Paths
CHROMA_DB_PATH=./data/chroma_db
DATA_SOURCE_PATH=./data/raw

# Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
GEMINI_EMBED_MODEL=gemini-embedding-2
GEMINI_GEN_MODEL=gemini-2.5-flash


